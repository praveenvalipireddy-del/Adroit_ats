# Copy this file to ".env" and fill in real values. Never commit the real ".env" to GitHub.

ENV=local

# From your Azure App Registration (Entra ID)
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# Redirect URIs - must match exactly what you register in Azure
LOCAL_REDIRECT_URI=http://localhost:5000/auth/callback
PROD_REDIRECT_URI=https://ats.aventra-ai.com/auth/callback

# Flask session secret - any random long string
SECRET_KEY=change-this-to-something-random

# Apify (for job scraping, add later)
APIFY_API_TOKEN=
